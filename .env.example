# Copy this file to .env, then replace all placeholder values.
# Never commit .env. The scripts load this root-level file into child processes.

# MySQL connection used by Spring Boot.
DB_URL=jdbc:mysql://localhost:3306/love_space?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=change-me

# A high-entropy one-time token required only while the site is uninitialized.
# Generate one with: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
SETUP_TOKEN=replace-with-a-random-64-character-token

# Optional password recovery token. Keep this separate from SETUP_TOKEN.
# Leave it empty to disable recovery. Generate and rotate a 256-bit token with:
#   pwsh -File scripts/rotate-password-reset-token.ps1 -UpdateEnv
# Restart the backend after rotation; startup logs show only a SHA-256 fingerprint.
PASSWORD_RESET_TOKEN=

# Independent password recovery limits (requests/failures per 15-minute window).
PASSWORD_RESET_MAX_ATTEMPTS_PER_IP=20
PASSWORD_RESET_MAX_FAILURES_PER_IDENTITY=5
PASSWORD_RESET_WINDOW_MINUTES=15
PASSWORD_RESET_LOCK_MINUTES=15
PASSWORD_RESET_EVICT_AFTER_MINUTES=30

# These three values are used by scripts/setup-db.ps1.
# Keep them consistent with DB_URL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=love_space

# Backend runtime (Spring Boot)
# For an HTTPS deployment, set SPRING_PROFILES_ACTIVE=prod and configure
# CORS_ALLOWED_ORIGINS to the exact public HTTPS origin before starting.
SERVER_PORT=8080
# start.ps1 defaults to loopback and overrides this to 0.0.0.0 with -Lan.
SERVER_ADDRESS=127.0.0.1
UPLOAD_DIR=./data/uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
MAX_FILE_SIZE=200MB
MAX_REQUEST_SIZE=220MB
MEDIA_MAX_BYTES=209715200
# Total media storage cap for this one couple space (2 GiB by default).
MEDIA_TOTAL_MAX_BYTES=2147483648

# Frontend runtime (Vite)
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:8080
